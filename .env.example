# Shared secret for the HTTP API. Required, min 16 characters.
# Clients send `Authorization: Bearer <key>` or raw `Authorization: <key>`.
API_KEY=change-me-to-a-long-random-string

# Master key for bot token encryption at rest: base64 of exactly 32 bytes.
# Generate: openssl rand -base64 32
TOKEN_ENC_KEY=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=

# Optional
SENTRY_DSN=
PORT=8080
APPLICATION_NAME=services_manager_server
POSTGRES_POOL_MAX_CONNECTIONS=10
POSTGRES_POOL_ACQUIRE_TIMEOUT_SEC=5
POSTGRES_POOL_MAX_LIFETIME_SEC=1800
RUST_LOG=info
